# ===================================================================
#  .env.production — copie para ".env.production" e preencha.
#  NUNCA envie este arquivo preenchido para e-mail/WhatsApp/Git.
#  Para gerar as chaves/senhas:  node deploy/gen-secrets.mjs
# ===================================================================

# Endereço público do site (o que o visitante digita). Tem que ser https://
APP_URL=https://turmadobairro.com.br

# Porta em que o app responde NESTE servidor, para o seu nginx encaminhar (confira se está livre: ss -tulpn)
APP_PORT=3400
# 0.0.0.0 = o nginx está em OUTRA máquina; 127.0.0.1 = o nginx roda neste mesmo servidor
APP_BIND=0.0.0.0

# Só se usar o Caddy opcional (docker compose --profile caddy ...): domínio sem https://
DOMAIN=turmadobairro.com.br

# Senha do banco (o app monta a DATABASE_URL sozinho). Use só letras/números.
POSTGRES_PASSWORD=

# Chaves (64 caracteres hexadecimais cada). FAÇA BACKUP DELAS em lugar seguro:
# sem a DATA_ENCRYPTION_KEY os CPFs gravados NÃO podem mais ser lidos.
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=
CRON_SECRET=

# Primeiro organizador (criado pelo seed). Depois do 1º acesso, APAGUE a senha daqui.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Organização Turma do Bairro

# ----- Mercado Pago -----
# Pode deixar em branco e informar em Painel › Configurações › Mercado Pago
# (o que for salvo no painel tem prioridade sobre estas variáveis).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_MAX_INSTALLMENTS=6
ORDER_HOLD_MINUTES=30

# ----- WhatsApp (WPPConnect) -----
# Se usar o serviço do próprio compose (--profile whatsapp): http://wppconnect:21465
# WPP_SECRET_KEY: invente uma chave (ex.: rode `node deploy/gen-secrets.mjs`). O servidor WPPConnect do compose usa a mesma.
WPP_BASE_URL=
WPP_SESSION=turmadobairro
WPP_SECRET_KEY=
WPP_TOKEN=

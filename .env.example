# ===== Aplicação =====
APP_URL=http://localhost:3000
NODE_ENV=development

# ===== Banco (PostgreSQL) =====
DATABASE_URL=postgresql://turma:turma_dev_pw@localhost:55432/turmadobairro?schema=public

# ===== Segurança (gere valores únicos: openssl rand -hex 32) =====
# Chave AES-256 (64 hex) para criptografar CPF e dados sensíveis em repouso
DATA_ENCRYPTION_KEY=
# Chave HMAC (64 hex) para índices cegos (busca/duplicidade de CPF sem guardar o CPF em claro)
DATA_HASH_KEY=
# Segredo para endpoints de cron (reenvio de WhatsApp / expirar pedidos)
CRON_SECRET=

# ===== Mercado Pago =====
# Credenciais de PRODUÇÃO (ou TESTE) em https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Painel > Suas integrações > Webhooks)
MP_WEBHOOK_SECRET=
# Máximo de parcelas no cartão
MP_MAX_INSTALLMENTS=6
# Minutos que o pedido fica reservado aguardando pagamento
ORDER_HOLD_MINUTES=30

# ===== WhatsApp (WPPConnect Server) =====
WPP_BASE_URL=http://localhost:21465
WPP_SESSION=turmadobairro
WPP_SECRET_KEY=THISISMYSECURETOKEN
# Opcional: se já tiver um token gerado, informe aqui (senão é gerado via secret key)
WPP_TOKEN=

# ===== Primeiro organizador (usado pelo seed) =====
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Organização Turma do Bairro

# ===== Uploads =====
UPLOAD_DIR=./storage/uploads
